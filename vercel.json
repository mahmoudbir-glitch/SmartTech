{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/*.js": {
      "maxDuration": 30,
      "includeFiles": "{catalog.js,i18n.js,i18n-pdp.js,i18n-order.js,i18n-cat.js,index.html,assets/copy.ar.json,assets/copy.en.json,assets/copy.tr.json,assets/taxonomy.json,assets/product-cat.json,assets/brands.json}"
    }
  },
  "rewrites": [
    {
      "source": "/p/:id(\\d+)",
      "destination": "/api/p?id=:id"
    },
    {
      "source": "/c/:path(.*)",
      "destination": "/api/c?path=:path"
    },
    {
      "source": "/b/:brand([a-z0-9-]+)",
      "destination": "/api/c?brand=:brand"
    },
    {
      "source": "/browse",
      "destination": "/api/c?index=1"
    },
    {
      "source": "/brands",
      "destination": "/api/c?brands=1"
    },
    {
      "source": "/o/:ref",
      "destination": "/api/o?ref=:ref"
    },
    {
      "source": "/checkout",
      "destination": "/checkout.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/products/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/brands/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/assets/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|svg|json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-ml0nWxOuBeItHs2zqDPQgx/5inKw+OAO/A1tK5hLbMs='; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
        }
      ]
    }
  ]
}
