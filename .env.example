# SmartTech — environment variables
# Copy to .env.local for `vercel dev`, or set them in Vercel → Settings →
# Environment Variables (Production, Preview and Development).
# Never commit real values. Changing ADMIN_PASSWORD or ADMIN_SECRET ends every
# open admin session.

# --- required -----------------------------------------------------------------

# Vercel Blob read/write token. Added automatically when a Blob store is
# connected to the project (Storage → Blob → Connect).
BLOB_READ_WRITE_TOKEN=

# Owner's admin-console password. 20+ characters.
ADMIN_PASSWORD=

# Random string (40+ characters) that signs admin sessions.
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRET=

# --- optional -----------------------------------------------------------------

# Full public origin once on a custom domain, e.g. https://smarttech.sy
# Without it the Vercel production URL is used. Canonical links, og:url and the
# sitemap are built from this, never from the request's Host header.
SITE_ORIGIN=

# Signs customer receipt links (/o/<ref>-<token>). Falls back to ADMIN_SECRET.
# Changing it invalidates every receipt link already sent.
ORDER_URL_SECRET=

# Resend API key for order-confirmation e-mail. Without it no e-mail is sent
# and everything else works the same.
RESEND_API_KEY=

# --- set by Vercel, do not define by hand ------------------------------------
# VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL

# --- tests only (tests/run-all.mjs sets these itself) ------------------------
# DEV_PORT=3100
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
