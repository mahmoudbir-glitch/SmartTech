{
  "name": "smarttech-store",
  "private": true,
  "version": "1.0.0",
  "dependencies": {
    "@vercel/blob": "2.8.0"
  },
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "node tests/run-all.mjs",
    "test:config": "node tests/config-test.mjs",
    "test:content": "node tests/content-test.mjs",
    "test:lang": "node tests/lang-test.mjs",
    "test:ui": "node tests/ui-test.mjs",
    "test:api": "node tests/api-test.mjs",
    "test:compat": "node tests/compat-test.mjs",
    "test:design": "node tests/design-test.mjs",
    "test:shop": "node tests/shop-test.mjs",
    "build": "node tools/build-taxonomy.cjs && node tools/build-brands.cjs && node tools/build-css.cjs && node tools/sync-head.cjs && node tools/sync-body.cjs && node tools/stamp-assets.cjs && node tools/stamp-csp.cjs",
    "lint": "node tools/lint.cjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:only": "node tests/run-all.mjs --only"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
